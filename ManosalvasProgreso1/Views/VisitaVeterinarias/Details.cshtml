@model ManosalvasProgreso1.Models.VisitaVeterinaria

@{
    ViewData["Title"] = "Detalles de Visita Veterinaria";
}

<h1 class="mt-3">Detalles de Visita</h1>
<hr />

<div class="mb-3">
    <strong>Fecha de Visita:</strong>
    <p>@Model.FechaVisita.ToShortDateString()</p>
</div>

<div class="mb-3">
    <strong>Motivo:</strong>
    <p>@Model.MotivoVisita</p>
</div>

<div class="mb-3">
    <strong>¿Requiere Medicación?</strong>
    <p>@(Model.RequiereMedicamento ? "Sí" : "No")</p>
</div>

<div class="mb-3">
    <strong>Mascota:</strong>
    <p>@Model.Mascota?.Nombre</p>
</div>

<div class="mb-3">
    <strong>Tarifa:</strong>
    <p>$@Model.Tarifa.ToString("F2")</p>
</div>

<a asp-action="Edit" asp-route-id="@Model.IdVisitaVeterinaria" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
