@model ManosalvasProgreso1.Models.VisitaVeterinaria

@{
    ViewData["Title"] = "Eliminar Visita Veterinaria";
}

<h1 class="mt-3">Eliminar Visita</h1>
<hr />

<h4>¿Está seguro que desea eliminar esta visita?</h4>

<div class="mb-3">
    <strong>Fecha:</strong> @Model.FechaVisita.ToShortDateString()<br />
    <strong>Motivo:</strong> @Model.MotivoVisita<br />
    <strong>Medicamento:</strong> @(Model.RequiereMedicamento ? "Sí" : "No")<br />
    <strong>Mascota:</strong> @Model.Mascota?.Nombre<br />
    <strong>Tarifa:</strong> $@Model.Tarifa.ToString("F2")
</div>

<form asp-action="DeleteConfirmed">
    <input type="hidden" asp-for="IdVisitaVeterinaria" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
