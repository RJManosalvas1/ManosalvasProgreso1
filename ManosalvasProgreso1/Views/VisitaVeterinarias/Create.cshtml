@model ManosalvasProgreso1.Models.VisitaVeterinaria

@{
    ViewData["Title"] = "Registrar Visita Veterinaria";
}

<h1 class="mt-3">Registrar Visita Veterinaria</h1>

<hr />

<form asp-action="Create">
    <div class="form-group mb-3">
        <label asp-for="FechaVisita" class="form-label"></label>
        <input asp-for="FechaVisita" class="form-control" />
        <span asp-validation-for="FechaVisita" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="MotivoVisita" class="form-label"></label>
        <select asp-for="MotivoVisita" class="form-select" onchange="calcularTarifa()">
            <option value="">-- Seleccione --</option>
            <option value="Vacunacion">Vacunación</option>
            <option value="RevisionGeneral">Revisión General</option>
            <option value="Cirugia">Cirugía</option>
        </select>
        <span asp-validation-for="MotivoVisita" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="IdMascota" class="form-label"></label>
        <select asp-for="IdMascota" class="form-select" asp-items="ViewBag.IdMascota">
            <option value="">-- Seleccione una mascota --</option>
        </select>
        <span asp-validation-for="IdMascota" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="RequiereMedicamento" class="form-check-input" />
        <label asp-for="RequiereMedicamento" class="form-check-label"></label>
    </div>

    <div class="mb-3">
        <label class="form-label">Tarifa estimada ($)</label>
        <input id="tarifa" class="form-control" readonly />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calcularTarifa() {
            const motivo = document.querySelector('[name="MotivoVisita"]').value;
            const tarifaInput = document.getElementById("tarifa");

            let tarifa = 0;
            switch (motivo) {
                case "Vacunacion":
                    tarifa = 30;
                    break;
                case "RevisionGeneral":
                    tarifa = 20;
                    break;
                case "Cirugia":
                    tarifa = 100;
                    break;
                default:
                    tarifa = 0;
            }

            tarifaInput.value = tarifa.toFixed(2);
        }
    </script>
}
