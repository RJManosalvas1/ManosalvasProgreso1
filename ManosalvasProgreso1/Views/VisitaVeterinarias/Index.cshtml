@model IEnumerable<ManosalvasProgreso1.Models.VisitaVeterinaria>

@{
    ViewData["Title"] = "Lista de Visitas Veterinarias";
}

<h2>@ViewData["Title"]</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Motivo</th>
            <th>Requiere Medicación</th>
            <th>Mascota</th>
            <th>Tarifa ($)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FechaVisita.ToShortDateString()</td>
                <td>@item.MotivoVisita</td>
                <td>@(item.RequiereMedicamento ? "Sí" : "No")</td>
                <td>@item.Mascota?.Nombre</td>
                <td>@item.Tarifa</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdVisitaVeterinaria" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.IdVisitaVeterinaria" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.IdVisitaVeterinaria" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Nueva Visita</a>
