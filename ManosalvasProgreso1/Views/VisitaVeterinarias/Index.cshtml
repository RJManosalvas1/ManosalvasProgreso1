@model IEnumerable<ManosalvasProgreso1.Models.VisitaVeterinaria>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FechaVisita)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MotivoVisita)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RequiereMedicamento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Mascota)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FechaVisita)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MotivoVisita)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RequiereMedicamento)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Mascota.IdMascota)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdVisitaVeterinaria">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdVisitaVeterinaria">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdVisitaVeterinaria">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
